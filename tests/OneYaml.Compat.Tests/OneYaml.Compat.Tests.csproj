<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <!-- The tests use the reflection-based API on purpose; trimming does not apply to a test assembly. -->
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2067;IL2070;IL2072</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- The real library, as the reference the compat package is checked against; never referenced by the package. -->
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="SharpYaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneYaml/OneYaml.csproj" />
    <ProjectReference Include="../../src/OneYaml.Compat.YamlDotNet/OneYaml.Compat.YamlDotNet.csproj" />
    <ProjectReference Include="../../src/OneYaml.Compat.SharpYaml/OneYaml.Compat.SharpYaml.csproj" />
  </ItemGroup>

</Project>
