<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Builds with the trim and AOT analyzers on. Native publishing is opt-in: run.sh passes
         PublishAot, because it needs the native toolchain and its own packages. -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <!-- run.sh sets SmokeMode. It is a project property, not PublishAot itself, because global
       properties flow into the generator project, which cannot be published natively. -->
  <PropertyGroup Condition="'$(SmokeMode)' == 'aot'">
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SmokeMode)' == 'trimmed'">
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <!-- The package ships this file; a project reference does not bring it, so import it here. It turns
       reflection off for trimmed and ahead-of-time publishing. -->
  <Import Project="../../src/OneYaml/buildTransitive/OneYaml.targets" />

  <ItemGroup>
    <ProjectReference Include="../../src/OneYaml/OneYaml.csproj" />
    <ProjectReference Include="../../src/OneYaml.SourceGeneration/OneYaml.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
