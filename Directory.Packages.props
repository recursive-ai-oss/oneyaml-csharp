<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <!-- Roslyn, for the source generator (build time only) and its tests. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
  <!-- Competitor parsers, used by the benchmarks only. -->
  <ItemGroup>
    <PackageVersion Include="VYaml" Version="1.4.0" />
    <PackageVersion Include="SharpYaml" Version="3.14.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- The only RFC 6902 route in the .NET libraries, for the patch benchmark. -->
    <PackageVersion Include="Yaml2JsonNode" Version="3.0.1" />
    <PackageVersion Include="JsonPatch.Net" Version="5.0.3" />
  </ItemGroup>
</Project>
