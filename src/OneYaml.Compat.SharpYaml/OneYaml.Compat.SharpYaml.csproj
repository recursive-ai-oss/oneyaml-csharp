<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OneYaml.Compat.SharpYaml</RootNamespace>
    <AssemblyName>OneYaml.Compat.SharpYaml</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- No package references to lock (see the OneYaml project). -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>OneYaml.Compat.SharpYaml</PackageId>
    <Description>A compatibility adapter covering a subset of the SharpYaml serializer API (YamlSerializer, YamlSerializerOptions, attributes), tested against SharpYaml 3.14.0, running on OneYaml. Every difference is listed.</Description>
    <Authors>Recursive AI, LLC</Authors>
    <Copyright>Copyright (c) 2026 Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/recursive-ai-oss/oneyaml-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageTags>yaml;sharpyaml;compat;serializer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../OneYaml/OneYaml.csproj" />
    <InternalsVisibleTo Include="OneYaml.Compat.Tests" />
    <InternalsVisibleTo Include="OneYaml.Benchmarks" />
  </ItemGroup>

  <!-- The compat package uses internals of OneYaml, so it works only with the exact version it was built against.
       Packing writes the OneYaml dependency as [version] instead of the open range >= version. -->
  <Target Name="PinOneYamlDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'OneYaml'" ProjectVersion="[$(PackageVersion)]" />
    </ItemGroup>
  </Target>

</Project>
