<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OneYaml</RootNamespace>
    <AssemblyName>OneYaml</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- This project has no package references to lock. The trimming analyzer package
         the SDK adds implicitly follows the installed SDK patch version, so a lock
         file here would only break restores on other SDK patches. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API without an XML doc comment is a build error (warnings are errors). -->
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>OneYaml</PackageId>
    <Description>Pure C# YAML 1.2 that edits a file and keeps its comments, with a System.Text.Json-style serializer.</Description>
    <Authors>Recursive AI, LLC</Authors>
    <Copyright>Copyright (c) 2026 Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <RepositoryUrl>https://github.com/recursive-ai-oss/oneyaml-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>yaml;yaml-1.2;serializer;parser</PackageTags>
  </PropertyGroup>

  <!-- The source generator is built first and shipped in the package as an analyzer, so adding the
       package is all it takes. It is a build-time tool: it adds no dependency to the package. -->
  <ItemGroup>
    <ProjectReference Include="../OneYaml.SourceGeneration/OneYaml.SourceGeneration.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../OneYaml.SourceGeneration/OneYaml.SourceGeneration.csproj" Targets="Build" />
    <MSBuild Projects="../OneYaml.SourceGeneration/OneYaml.SourceGeneration.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_GeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_GeneratorAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The package page on NuGet shows this short readme: the repository README has relative links and generated charts that NuGet does not render. -->
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/OneYaml.targets" Pack="true" PackagePath="buildTransitive/" />
    <EmbeddedResource Include="ILLink.Substitutions.xml" LogicalName="ILLink.Substitutions.xml" />
    <InternalsVisibleTo Include="OneYaml.Tests" />
    <InternalsVisibleTo Include="OneYaml.Benchmarks" />
    <InternalsVisibleTo Include="OneYaml.Fuzz" />
    <!-- The compat layer reads the document tree and writes scalars through the same engine, so it needs the internal tree and writer. -->
    <InternalsVisibleTo Include="OneYaml.Compat.YamlDotNet" />
    <!-- The SharpYaml shim asks the reader how deep the current value sits. -->
    <InternalsVisibleTo Include="OneYaml.Compat.SharpYaml" />
  </ItemGroup>

</Project>
